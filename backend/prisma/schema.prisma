generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model activity_events {
  id            String     @id(map: "activity_events_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String     @db.Uuid
  actor_user_id String     @db.Uuid
  task_id       String     @db.Uuid
  task_title    String     @db.VarChar(200)
  action        String     @db.VarChar(32)
  from_status   String?    @db.VarChar(20)
  to_status     String?    @db.VarChar(20)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  users         users      @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_events_actor_user_id_fkey")
  workspaces    workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activity_events_workspace_id_fkey")

  @@index([workspace_id, created_at(sort: Desc), id(sort: Desc)], map: "ix_activity_events_workspace_time")
  @@index([workspace_id, task_id, created_at(sort: Desc), id(sort: Desc)], map: "ix_activity_events_workspace_task_time")
}

