model attachments {
  id                  String        @id(map: "pk_attachments") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id        String        @db.Uuid
  task_id             String?       @db.Uuid
  note_node_id        String?       @db.Uuid
