  mime_type           String        @db.VarChar(255)
  size_bytes          BigInt
  storage_key         String        @unique(map: "uq_attachments_storage_key")
  uploaded_by_user_id String        @db.Uuid
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  canvas_nodes        canvas_nodes? @relation(fields: [workspace_id, note_node_id], references: [workspace_id, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attachments_note_node")
  tasks               tasks?        @relation(fields: [workspace_id, task_id], references: [workspace_id, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attachments_task")
  users               users         @relation(fields: [uploaded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attachments_uploaded_by_user_id")
  workspaces          workspaces    @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attachments_workspace_id")

  @@index([workspace_id, note_node_id], map: "ix_attachments_workspace_note", where: raw("(note_node_id IS NOT NULL)"))
  @@index([workspace_id, task_id], map: "ix_attachments_workspace_task", where: raw("(task_id IS NOT NULL)"))
}

