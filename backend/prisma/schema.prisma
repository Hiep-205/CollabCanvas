  @@index([workspace_id, task_id, created_at(sort: Asc)], map: "ix_task_comments_task_time", where: raw("(deleted_at IS NULL)"))
  @@index([parent_comment_id], map: "ix_task_comments_parent", where: raw("((parent_comment_id IS NOT NULL) AND (deleted_at IS NULL))"))
  @@index([workspace_id, deleted_at(sort: Desc)], map: "ix_task_comments_workspace_deleted", where: raw("(deleted_at IS NOT NULL)"))
