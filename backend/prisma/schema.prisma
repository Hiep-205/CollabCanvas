  workspace_members workspace_members @relation(fields: [workspace_id, mentioned_user_id], references: [workspace_id, user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_mentions_member")
  users             users             @relation(fields: [mentioned_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_mentions_user")

  @@id([comment_id, mentioned_user_id], map: "pk_comment_mentions")
