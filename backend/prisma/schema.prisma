  users            users              @relation(fields: [author_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_task_comments_author")
  tasks            tasks              @relation(fields: [workspace_id, task_id], references: [workspace_id, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_task_comments_task")
  workspaces       workspaces         @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_task_comments_workspace")
